# ==========================================
# CanteenPulse - Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/canteenpulse
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/canteenpulse?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/canteenpulse

# Administrator Passcode / Secret for Demo
ADMIN_PASSCODE=admin123
ADMIN_SECRET=canteenpulse_secret_key_2026
