# ==========================================
# CanteenPulse - Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB Atlas Cloud Connection String
# 1. Replace <username> and <password> with your MongoDB Atlas database user credentials
# 2. Replace <cluster-url> with your Atlas cluster domain (e.g. cluster0.abcde.mongodb.net)
# 3. Ensure the database name is 'canteenpulse'
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/canteenpulse?retryWrites=true&w=majority

# Administrator Passcode & Security Secret
ADMIN_PASSCODE=admin123
ADMIN_SECRET=canteenpulse_secret_key_2026
